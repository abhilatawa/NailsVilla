# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DATABASE_NAME=nailsvilla
DATABASE_USERNAME=nailsvilla
DATABASE_PASSWORD=change-me-in-production
# Used only when running the backend directly (mvn spring-boot:run) against Postgres
# started via `docker compose up postgres`. Inside docker compose, the backend service
# is given a DATABASE_URL pointing at the `postgres` service hostname instead.
DATABASE_URL=jdbc:postgresql://localhost:5432/nailsvilla

# --- Security ---
# Generate a long random value for production, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-in-production

# --- Business configuration (see docs/IMPLEMENTATION_PLAN.md for what these affect) ---
SALON_NAME=Nails Villa
SALON_TIMEZONE=America/Halifax
SALON_CURRENCY=CAD
SALON_CITY=Halifax
SALON_PROVINCE=Nova Scotia
SALON_COUNTRY=Canada

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Mail ---
# Left blank in development; leave a fake SMTP server (e.g. MailHog/Mailpit) at this
# host/port, or point at a real provider in production.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
